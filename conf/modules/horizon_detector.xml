<!DOCTYPE module SYSTEM "module.dtd">

<module name="horizon_detector" dir="danger_detector">
  <doc>
    <description>
Standalone horizon detector for TU Delft Cyberzoo experiments.

This module estimates a per-row floor boundary by scanning each sampled row
from right to left for a run of green pixels. It then validates boundary points
using local slope and slope-change checks, and reports per-zone booleans:
  0 = zone horizon considered valid
  1 = zone horizon considered invalid

It is intentionally separate from danger_detector and is not wired into the
flight plan by default.
    </description>
    <define name="HORIZON_DETECTOR_CAMERA" value="front_camera" description="Camera device to use for detection"/>
    <define name="HORIZON_DETECTOR_FPS" value="0" description="Desired FPS (0 = camera rate)"/>
    <define name="HORIZON_DETECTOR_NUM_ZONES" value="12" description="Number of horizontal zones"/>
    <define name="HORIZON_DETECTOR_SENDER_ID" value="2" description="ABI sender ID for this detector"/>
    <define name="HORIZON_DETECTOR_DATA_TYPE" value="2" description="ABI PAYLOAD_DATA data_type value"/>
    <define name="HORIZON_DETECTOR_VERBOSE" value="" description="Define to print per-zone flags"/>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="HorizonDetector">
        <dl_setting var="hh_row_step"                  min="1"    step="1"    max="20"  shortname="row_step"/>
        <dl_setting var="hh_min_green_run"             min="1"    step="1"    max="32"  shortname="green_run"/>
        <dl_setting var="hh_green_min"                 min="0"    step="1"    max="255" shortname="g_min"/>
        <dl_setting var="hh_green_max"                 min="0"    step="1"    max="255" shortname="g_max"/>
        <dl_setting var="hh_red_min"                   min="0"    step="1"    max="255" shortname="r_min"/>
        <dl_setting var="hh_green_minus_blue_min"      min="-128" step="1"    max="127" shortname="g-b_min"/>
        <dl_setting var="hh_green_minus_red_min"       min="-128" step="1"    max="127" shortname="g-r_min"/>
        <dl_setting var="hh_floor_strip_frac"          min="0.0"  step="0.01" max="1.0" shortname="strip_f"/>
        <dl_setting var="hh_invalid_percent_threshold" min="0.0"  step="1.0"  max="100" shortname="inv_thr"/>
        <dl_setting var="hh_max_slope"                 min="0.1"  step="0.1"  max="10"  shortname="slope"/>
        <dl_setting var="hh_max_slope_change"          min="0.1"  step="0.1"  max="10"  shortname="d_slope"/>
        <dl_setting var="hh_slope_window"              min="1"    step="1"    max="10"  shortname="window"/>
        <dl_setting var="hh_draw"                      min="0"    step="1"    max="1"   shortname="draw" values="False|True"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="horizon_detector.h"/>
  </header>

  <init fun="horizon_detector_init()"/>
  <periodic fun="horizon_detector_periodic()" freq="4"/>

  <makefile target="ap|nps">
    <file name="horizon_detector.c"/>
  </makefile>
</module>
